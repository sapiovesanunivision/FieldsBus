<!-- Generated by CMake from dotnet/sample/SoftEipSample.csproj.in - edit the template, not this file. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>@SOFTEIP_CS_TFM@</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SoftEipSample</AssemblyName>
    <RootNamespace>SoftEipSample</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>@SOFTEIP_BIN_DIR@/$(Configuration)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="@SOFTEIP_SAMPLE_SRC@/Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- C++/CLI wrapper built by the SoftEip.Net project of the same solution -->
    <Reference Include="SoftEip.Net">
      <HintPath>@SOFTEIP_BIN_DIR@/$(Configuration)/SoftEip.Net.dll</HintPath>
      <!-- Must stay true: on .NET 5+ a Private=false reference is left out of
           SoftEipSample.deps.json and the host then refuses to load the app-local
           SoftEip.Net.dll (FileNotFoundException), even though it sits next to the exe.
           Both projects share the output folder, so the copy itself is a no-op. -->
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
